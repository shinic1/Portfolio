{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nicobot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "nicobot-portfolio"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "2026072701",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
